# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# Optional: override the vision model used for AI tagging.
# Defaults to meta-llama/llama-4-scout-17b-16e-instruct (fast, cheap).
# Try meta-llama/llama-4-maverick-17b-128e-instruct for higher accuracy.
EXPO_PUBLIC_GROQ_VISION_MODEL=
