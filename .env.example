# Copy this file to .env. Never commit .env.

# The Worker that does AI tagging (see worker/ and ARCHITECTURE.md).
# Local development:  http://127.0.0.1:8787   (npx wrangler dev, run from worker/)
# Deployed:           https://snaplocker-api.<your-subdomain>.workers.dev
EXPO_PUBLIC_API_URL=

# The Groq API key is NOT here any more. It lives on the Worker as a secret:
#   cd worker && npx wrangler secret put GROQ_API_KEY
# Anything prefixed EXPO_PUBLIC_ is embedded in the built JavaScript in plain text,
# so a key here is handed to every visitor of the site.
