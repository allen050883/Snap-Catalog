# Copy this file to .env and fill in your own key. Never commit .env.
# Get a key at https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# Optional: override the vision model used for AI tagging.
# Defaults to qwen/qwen3.8-27b, the multimodal model Groq currently serves.
# Only set this to another *vision* model -- Groq's gpt-oss models are text-only
# and reject the image. Check what you have access to with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $EXPO_PUBLIC_GROQ_API_KEY"
EXPO_PUBLIC_GROQ_VISION_MODEL=
