{
  "expo": {
    "name": "Snap Catalog",
    "slug": "snap-catalog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snapcatalog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.allen050883.snapcatalog",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap Catalog needs camera access to photograph your collectibles.",
        "NSPhotoLibraryUsageDescription": "Snap Catalog needs photo library access to pick photos of your collectibles."
      }
    },
    "android": {
      "package": "com.allen050883.snapcatalog",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Snap Catalog needs photo library access to pick photos of your collectibles.",
          "cameraPermission": "Snap Catalog needs camera access to photograph your collectibles."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
